<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/iv_foto_perfil"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="48dp"
        android:src="@mipmap/ic_launcher_round"
        android:contentDescription="Foto de perfil" />

    <ImageView
        android:id="@+id/iv_seleccion_foto"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@android:drawable/ic_menu_camera"
        android:contentDescription="Cambiar foto"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="125dp" />

    <ImageView
        android:id="@+id/iv_editar_conductor"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_edit"
        android:contentDescription="Editar perfil"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="40dp" />

    <TextView
        android:id="@+id/tv_titulo_numero_personal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Número Personal"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_below="@+id/iv_seleccion_foto"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp" />

    <TextView
        android:id="@+id/tv_numero_personal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_titulo_numero_personal"
        android:layout_marginStart="20dp"
        android:layout_marginTop="7dp"
        android:text="1234567890"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_titulo_nombre_completo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre Completo"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_below="@+id/tv_numero_personal"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp" />

    <TextView
        android:id="@+id/tv_nombre_completo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_titulo_nombre_completo"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:text="Isaid Ochoa Tadeo"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_titulo_sucursal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sucursal"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_below="@+id/tv_nombre_completo"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp" />

    <TextView
        android:id="@+id/tv_sucursal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_titulo_sucursal"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:text="CDMX Sur"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_titulo_rol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rol"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_below="@+id/tv_sucursal"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp" />

    <TextView
        android:id="@+id/tv_rol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_titulo_rol"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:text="Conductor"
        android:textSize="14sp" />

</RelativeLayout>