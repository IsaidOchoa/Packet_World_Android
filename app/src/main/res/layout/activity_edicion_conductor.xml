<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".EdicionConductorActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llBackHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="45dp"
                    android:layout_height="42dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Regresar"
                    android:padding="4dp"
                    android:src="@drawable/ic_arrow_back_24" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Editar Perfil"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_label_numero_personal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Número de Personal"
                android:textColor="#7F8C8D"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNumeroPersonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="N/A"
                android:textSize="14sp"
                android:textColor="#7F8C8D"/>

            <TextView
                android:id="@+id/tv_label_sucursal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sucursal"
                android:textColor="#7F8C8D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                />

            <TextView
                android:id="@+id/tvSucursal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="N/A"
                android:textColor="#7F8C8D"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_label_rol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rol"
                android:textColor="#7F8C8D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="N/A"
                android:textColor="#7F8C8D"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#000000" />

            <TextView
                android:id="@+id/tv_label_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:importantForAccessibility="yes"
                android:autofillHints="name"
                android:hint="Nombre" />

            <TextView
                android:id="@+id/tv_label_apellido_paterno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apellido Paterno"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etApellidoPaterno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:importantForAccessibility="yes"
                android:autofillHints="familyName"
                android:hint="Apellido Paterno" />

            <TextView
                android:id="@+id/tv_label_apellido_materno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apellido Materno"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etApellidoMaterno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:importantForAccessibility="yes"
                android:autofillHints="familyName"
                android:hint="Apellido Materno" />

            <TextView
                android:id="@+id/tv_label_correo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo Electrónico"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textEmailAddress"
                android:minHeight="48dp"
                android:importantForAccessibility="yes"
                android:autofillHints="emailAddress"
                android:hint="Correo Electrónico" />

            <TextView
                android:id="@+id/tv_label_licencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Número de Licencia"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <EditText
                android:id="@+id/etLicencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="text"
                android:minHeight="48dp"
                android:importantForAccessibility="yes"
                android:hint="Número de Licencia"
                android:visibility="gone"/>

            <!-- Seccion de Cambio de password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cambio de Contraseña"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tv_label_password_actual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contraseña Actual"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="?attr/colorControlNormal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPasswordActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:minHeight="48dp"
                    android:importantForAccessibility="yes"
                    android:hint="Contraseña actual" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_label_password_nueva"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nueva Contraseña"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="?attr/colorControlNormal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPasswordNueva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:minHeight="48dp"
                    android:importantForAccessibility="yes"
                    android:hint="Nueva contraseña" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_label_password_confirmar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirmar Nueva Contraseña"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="?attr/colorControlNormal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPasswordConfirmar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:minHeight="48dp"
                    android:importantForAccessibility="yes"
                    android:hint="Confirmar nueva contraseña" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnActualizar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actualizar"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#3471db"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>