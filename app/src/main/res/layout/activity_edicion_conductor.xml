<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".EdicionConductorActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Editar Perfil"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="16dp" />

            <!-- Número Personal (NO editable) -->
            <TextView
                android:id="@+id/tv_label_numero_personal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Número Personal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <TextView
                android:id="@+id/tvNumeroPersonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="1234567890"
                android:textSize="14sp" />

            <!-- Sucursal (NO editable) -->
            <TextView
                android:id="@+id/tv_label_sucursal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sucursal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/tvSucursal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CDMX Sur"
                android:textSize="14sp" />

            <!-- Rol (NO editable) -->
            <TextView
                android:id="@+id/tv_label_rol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rol"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/tvRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Conductor"
                android:textSize="14sp" />

            <!-- Nombre -->
            <TextView
                android:id="@+id/tv_label_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:importantForAccessibility="yes"
                android:autofillHints="name"
                android:hint="Nombre" />

            <!-- Apellido Paterno -->
            <TextView
                android:id="@+id/tv_label_apellido_paterno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apellido Paterno"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etApellidoPaterno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:importantForAccessibility="yes"
                android:autofillHints="familyName"
                android:hint="Apellido Paterno" />

            <!-- Apellido Materno -->
            <TextView
                android:id="@+id/tv_label_apellido_materno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apellido Materno"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etApellidoMaterno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:importantForAccessibility="yes"
                android:autofillHints="familyName"
                android:hint="Apellido Materno" />

            <!-- Correo -->
            <TextView
                android:id="@+id/tv_label_correo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo Electrónico"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="textEmailAddress"
                android:minHeight="48dp"
                android:importantForAccessibility="yes"
                android:autofillHints="emailAddress"
                android:hint="Correo Electrónico" />

            <!-- Botón Actualizar -->
            <Button
                android:id="@+id/btnActualizar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actualizar"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>