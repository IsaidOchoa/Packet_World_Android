<!-- Resumen del nuevo layout (solo el contenido dentro del ScrollView) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header con flecha de retroceso -->
        <LinearLayout
            android:id="@+id/llBackHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="45dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Regresar"
                android:padding="4dp"
                android:src="@drawable/ic_arrow_back_24" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mi Unidad"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Imagen de la unidad -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="141dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <ImageView
                android:id="@+id/ivImagenUnidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="Imagen de la unidad"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_car_default" />

        </androidx.cardview.widget.CardView>

        <!-- Contenedor para los datos de la unidad -->
        <LinearLayout
            android:id="@+id/llDatosUnidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Marca -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marca"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:layout_marginBottom="12dp" />

            <!-- Modelo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modelo"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:layout_marginBottom="12dp" />

            <!-- Año -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Año"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvAnio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:layout_marginBottom="12dp" />

            <!-- VIN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VIN"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvVin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:layout_marginBottom="12dp" />

            <!-- Número de Placa -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Número de Placa"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNii"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:layout_marginBottom="12dp" />

            <!-- Separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#ccc"
                android:layout_marginVertical="16dp" />

            <!-- Tipo de Unidad -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de Unidad"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvTipoUnidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

        <!-- Mensaje de "No tiene unidad asignada" -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvMensajeSinUnidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actualmente no tienes una unidad asignada. Por favor, ponte en contacto con tu jefe directo para que te sea asignada."
                android:textAlignment="center"
                android:textSize="18sp"
                android:textStyle="italic"
                android:padding="16dp"
                android:background="@color/gray_light" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</LinearLayout>